{
  "name": "ody",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/main.js",
  "scripts": {
    "dev": "ODY_QA_DISPLAY=portrait-right electron-vite dev --watch",
    "prebuild": "sh scripts/build-notify-helper.sh",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "bench:store": "node scripts/bench-store.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "pnpm build && electron-builder --mac"
  },
  "dependencies": {
    "get-windows": "10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "get-windows"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "lucide-react": "1.70.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "type": "module",
  "build": {
    "appId": "com.gobeomsu.ody",
    "productName": "ody",
    "copyright": "ody",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/get-windows/main"
    ],
    "extraFiles": [
      {
        "from": "build/bin/ody-notify-auth",
        "to": "MacOS/ody-notify-auth"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "ody reads the URL of the frontmost browser tab to record which site you work on.",
        "LSUIElement": true
      }
    }
  }
}
